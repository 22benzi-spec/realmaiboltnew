#!/bin/sh
# realmaiboltnew-push-document-hook

remote_name="$1"
zero_sha="0000000000000000000000000000000000000000"

while read local_ref local_sha remote_ref remote_sha
do
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  [ "$local_sha" = "$zero_sha" ] && continue

  if [ "$remote_sha" = "$zero_sha" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes="$remote_name")
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi

  has_document=0
  for commit_sha in $commits
  do
    if git diff-tree --root --no-commit-id --name-only -r "$commit_sha" |
      awk '/^commit\/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]-[0-9][0-9]-[0-9][0-9]\.md$/ { found=1 } END { exit(found ? 0 : 1) }'
    then
      has_document=1
      break
    fi
  done

  if [ "$has_document" -ne 1 ]; then
    echo "推送已阻止：分支 ${remote_ref#refs/heads/} 的待推送提交中没有推送说明文档。" >&2
    echo "请使用 scripts/Push-WithDocument.ps1 生成并提交 commit/YYYY-MM-DD HH-mm-ss.md。" >&2
    exit 1
  fi
done

exit 0
